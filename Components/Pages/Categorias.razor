@page "/categorias";

<h3>Categorias</h3>

<div class="row">
    <div class="col-md-4">
        <div class="card card-body">
            <EditForm Model="categoriaFormulario" OnValidSubmit="AdicionarCategoria">
                <DataAnnotationsValidator />

                <label class="form-label">Descrição:</label>
                <InputText class="form-control mb-2" @bind-Value="categoriaFormulario.Nome"/>
                <ValidationMessage For="@(() => categoriaFormulario.Nome)"/>

                <label class="form-label">Quantidade:</label>
                <InputNumber class="form-control mb-2" @bind-Value="categoriaFormulario.Quantidade" />
                <ValidationMessage For="@(() => categoriaFormulario.Quantidade)"/>
                
                <button class="btn btn-primary" type="submit">Adicionar categoria</button>
                
            </EditForm>
        </div>
    </div>
    
    <div class="col-md-8">
        <table class="table table-striped">
            <thead>
            <tr>
                <th>Descrição</th>
                <th>Quantidade</th>
            </tr>
            </thead>    
            <tbody>
                @if (categorias.Count == 0)
                {
                    <p class="text-muted">Nenhuma categoria cadastrada...</p>
                }
                else
                {
                    @foreach (var c in categorias)
                    {
                        <tr>
                            <td>@c.Nome</td>
                            <td>@c.Quantidade</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private Categoria categoriaFormulario = new();
    private List<Categoria> categorias = new();

    private void AdicionarCategoria()
    {
        categorias.Add(new Categoria{
            Nome = categoriaFormulario.Nome,
            Quantidade = categoriaFormulario.Quantidade
        });
        categoriaFormulario.Nome = "";
        categoriaFormulario.Quantidade = 0;
    }
}